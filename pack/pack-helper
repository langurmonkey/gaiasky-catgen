#!/bin/bash

me=`basename "$0"`

function usage() {
echo "Usage: $me LOCATION KEY METADATA_JSON"
echo
echo -e "\tLOCATION        Location in the file system. Must contain log, metadata.bin, particles."
echo -e "\tKEY             The catalog lookup name as a single word (i.e. 'best', '2M')."
echo -e "\t                Only used for reporting; the dataset key is taken from the"
echo -e "\t                metadata's 'key' attribute (e.g. 'gaia-dr4-plx-2M')."
echo -e "\tMETADATA_JSON   JSON file with the metadata object for this catalog."
echo -e "\t                See conf/catalogs-*.json, the 'metadata' object of the catalog."
echo
echo "Supported metadata attributes:"
echo -e "\tkey             (required) dataset key, e.g. 'gaia-dr3-small'."
echo -e "\tname            (required) dataset name."
echo -e "\ttype            (required) dataset type ('catalog-lod', 'catalog-gaia', etc.)."
echo -e "\tdescription     (required) dataset description."
echo -e "\tepoch           (required) reference epoch."
echo -e "\tversion         (required) version number."
echo -e "\tmingsversion    (optional) minimum Gaia Sky version. Defaults to 3060100."
echo -e "\treleasenotes    (optional) release notes. String or array of strings."
echo -e "\tlink            (optional, legacy) single catalog link."
echo -e "\tlinks           (optional) array of catalog links. Takes precedence over 'link'."
echo -e "\treplaces        (optional) key(s) of the datasets this one replaces. String or array."
echo -e "\tcreator         (optional) dataset creator."
echo -e "\tcredits         (optional) array of credits."
echo
echo "Example:"
echo "$me gscatalogpack ./000-20220531-dr3-default dr3-default /tmp/dr3-default-metadata.json"
}

SCRIPT_FILE=$(readlink -f "$0")
SCRIPT_DIR=$(dirname $SCRIPT_FILE)

if [ "$#" -ne 3 ]; then
	usage
	exit 1
fi

LOCATION=$1
KEY=$2
META_JSON=$3

if [ ! -d "$LOCATION" ] || [ ! -d "$LOCATION"/particles ]; then
	echo "ERROR: location does not exist or it does not contain a dataset: $LOCATION"
	exit 1
fi

if [ ! -f "$META_JSON" ]; then
	echo "ERROR: metadata JSON file does not exist: $META_JSON"
	exit 1
fi

# Helper to extract a scalar (string or number) attribute from the metadata JSON.
# Missing or non-scalar attributes yield an empty string.
# Usage: get_meta <attribute>
function get_meta() {
	jq -r --arg a "$1" 'if (.[$a] | type) == "string" or (.[$a] | type) == "number" then .[$a] else "" end' $META_JSON
}

# Helper to extract an attribute preserving its JSON type (string or array of
# strings). Missing or otherwise-typed attributes yield the JSON null, which is
# removed from the final descriptor. Output is always a single compact line.
# Usage: get_json <attribute>
function get_json() {
	jq -c --arg a "$1" 'if (.[$a] | type) == "string" or (.[$a] | type) == "array" then .[$a] else null end' $META_JSON
}

# The dataset key comes from the metadata itself (e.g. 'gaia-dr4-plx-2M'),
# not from the single-word lookup name (e.g. '2M').
DSKEY=$(get_meta key)
if [ -z "$DSKEY" ]; then
  echo "ERROR: metadata has no 'key' attribute!"
  exit 1
fi

case "$DSKEY" in
*\ *)
	echo "ERROR: dataset key can not contain spaces: $DSKEY"
	exit 1
	;;
esac

NAME=$(get_meta name)
TYPE=$(get_meta type)
DESCRIPTION=$(get_meta description)
EPOCH=$(get_meta epoch)
VERSION=$(get_meta version)
MINGSSVERSION=$(get_meta mingsversion)

# Attributes that may be a string (legacy) or an array: keep the type as-is.
NOTES_JSON=$(get_json releasenotes)
REPLACES_JSON=$(get_json replaces)
CREDITS_JSON=$(get_json credits)

# links: array of strings, with backwards compatibility with the legacy 'link'.
# 'links' takes precedence; if only 'link' is present it becomes a 1-element
# array. Conversely, 'link' mirrors the first element of 'links'.
LINKS_JSON=$(jq -c 'if (.links | type) == "array" then .links elif (.links | type) == "string" then [.links] elif (.link | type) == "string" then [.link] else null end' $META_JSON)
LINK=$(jq -r 'if (.links | type) == "array" and (.links | length) > 0 then .links[0] elif (.links | type) == "string" then .links elif (.link | type) == "string" then .link else "" end' $META_JSON)
CREATOR=$(get_meta creator)

if [ -z "$NAME" ] || [ -z "$DESCRIPTION" ]; then
  echo "ERROR: could not retrieve metadata (name and description are required)!"
  exit 1
fi

CATALOG_BASE=$LOCATION/catalog-$DSKEY
CATALOG_FOLDER=$CATALOG_BASE/catalog
CATALOG_FILE=$CATALOG_BASE/dataset.json
CATALOG_DATA=$CATALOG_FOLDER/$DSKEY

echo "CATALOG_FOLDER: $CATALOG_FOLDER"
echo "CATALOG_FILE:   $CATALOG_FILE"
echo "CATALOG_DATA:   $CATALOG_DATA"

# PARSE DATA AND CHECK VALUES

# Get size in bytes of dataset
SIZE_BYTES=$(set -- $(du -b --max-depth=1 $LOCATION) && AUXVAR=$(( $# - 1 )) && echo ${!AUXVAR})
# Get particles
NOBJECTS=$(set -- $(grep Particles: $LOCATION/log) && echo ${!#})


# Check values
if [ -z "$VERSION" ]; then
    echo "ERROR: Version is empty"
    exit 1
fi
if [ -z "$SIZE_BYTES" ]; then
    echo "ERROR: Size (bytes) is empty"
    exit 1
fi
if [ -z "$NOBJECTS" ]; then
    echo "ERROR: Nobjects is empty"
    exit 1
fi

echo "SIZE:           $SIZE_BYTES bytes"
echo "NOBJECTS:       $NOBJECTS"
echo "EPOCH:          $EPOCH"
echo "VERSION:        $VERSION"
echo "LINK:           $LINK"
echo "LINKS:          ${LINKS_JSON:-null}"
echo "REPLACES:       ${REPLACES_JSON:-null}"
echo "CREATOR:        $CREATOR"
echo "CREDITS:        ${CREDITS_JSON:-null}"

# CREATE AND MOVE CATALOG
mkdir -p $CATALOG_DATA
mv $LOCATION/log $LOCATION/metadata.bin $LOCATION/particles $CATALOG_DATA

# PREPARE JSON DESCRIPTOR FILE
cp $SCRIPT_DIR/catalog-template.json $CATALOG_FILE

# Substitute a quoted placeholder with a compact, single-line JSON value
# (string or array), inserted verbatim. The value is escaped for the sed
# replacement so that '&', '\' and the '|' delimiter are taken literally.
# Usage: set_json <placeholder> <json-value>
function set_json() {
  local PH=$1
  local VAL=$2
  local ESCAPED
  if [ -z "$VAL" ]; then
    VAL='null'
  fi
  ESCAPED=$(printf '%s' "$VAL" | sed -e 's/[\\&|]/\\&/g')
  sed -i "s|\"<$PH>\"|$ESCAPED|g" $CATALOG_FILE
}

# Bare KEY substitution (unquoted placeholders in the file paths), then the
# quoted one. Both use the dataset key from the metadata.
sed -i "s|<KEY>|$DSKEY|g" $CATALOG_FILE

set_json NAME "\"$NAME\""
set_json TYPE "\"$TYPE\""
set_json DESCRIPTION "\"$DESCRIPTION\""
set_json CREATOR "\"$CREATOR\""
set_json NOTES "$NOTES_JSON"
set_json REPLACES "$REPLACES_JSON"
set_json LINKS "$LINKS_JSON"
set_json CREDITS "$CREDITS_JSON"
set_json LINK "\"$LINK\""

# Numeric fields: substitute without quotes.
function subst_num() {
  local PH=$1
  local VAL=$2
  sed -i "s/<$PH>/$VAL/g" $CATALOG_FILE
}
subst_num VERSION "$VERSION"
subst_num EPOCH "$EPOCH"
subst_num SIZE_BYTES "$SIZE_BYTES"
subst_num NOBJECTS "$NOBJECTS"

# mingsversion: use metadata value if present, otherwise keep the template default.
if [ -n "$MINGSSVERSION" ]; then
  sed -i 's/"mingsversion": 3060100/"mingsversion": '"$MINGSSVERSION"'/' $CATALOG_FILE
fi

# Remove optional attributes that are missing (null), empty strings or empty
# arrays, so they do not appear in the final descriptor.
jq 'with_entries(select(.value != null and .value != "" and ((.value | type) != "array" or (.value | length) > 0)))' $CATALOG_FILE > $CATALOG_FILE.tmp && mv $CATALOG_FILE.tmp $CATALOG_FILE

# Validate the generated descriptor.
jq -e . $CATALOG_FILE > /dev/null 2>&1
if [ $? -ne 0 ]; then
  echo "ERROR: generated dataset.json is not valid JSON: $CATALOG_FILE"
  exit 1
fi

# TAR
TAR_FILE=catalog-$DSKEY.tar.gz
cd $LOCATION
tar -czvf $TAR_FILE catalog-$DSKEY

set -- $(md5sum "$TAR_FILE") && echo $1 > md5
set -- $(sha256sum "$TAR_FILE") && echo $1 > sha256
cd -

echo "Done: $LOCATION/$TAR_FILE"
