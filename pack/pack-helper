#!/bin/bash

me=`basename "$0"`

function usage() {
echo "Usage: $me LOCATION KEY METADATA_JSON"
echo
echo -e "\tLOCATION        Location in the file system. Must contain log, metadata.dat, particles."
echo -e "\tKEY             The dataset key in the metadata files (gaia-dr3-small)."
echo -e "\tMETADATA_JSON   JSON file with the metadata object for this catalog."
echo -e "\t                See conf/catalogs-*.json, the 'metadata' object of the catalog."
echo
echo "Supported metadata attributes:"
echo -e "\tkey             (required) dataset key, e.g. 'gaia-dr3-small'."
echo -e "\tname            (required) dataset name."
echo -e "\ttype            (required) dataset type ('catalog-lod', 'catalog-gaia', etc.)."
echo -e "\tdescription     (required) dataset description."
echo -e "\tepoch           (required) reference epoch."
echo -e "\tversion         (required) version number."
echo -e "\tmingsversion    (optional) minimum Gaia Sky version. Defaults to 3060100."
echo -e "\treleasenotes    (optional) release notes. String or array of strings."
echo -e "\tlink            (optional, legacy) single catalog link."
echo -e "\tlinks           (optional) array of catalog links. Takes precedence over 'link'."
echo -e "\treplaces        (optional) key(s) with the datasets this one replaces. String or array."
echo -e "\tcreator         (optional) dataset creator."
echo -e "\tcredits         (optional) array of credits."
echo
echo "Example:"
echo "$me gscatalogpack ./000-20220531-dr3-default dr3-default /tmp/dr3-default-metadata.json"
}

SCRIPT_FILE=$(readlink -f "$0")
SCRIPT_DIR=$(dirname $SCRIPT_FILE)

if [ "$#" -ne 3 ]; then
	usage
	exit 1
fi

LOCATION=$1
KEY=$2
META_JSON=$3

if [ ! -d "$LOCATION" ] || [ ! -d "$LOCATION"/particles ]; then
	echo "ERROR: location does not exist or it does not contain a dataset: $LOCATION"
	exit 1
fi

if [ ! -f "$META_JSON" ]; then
	echo "ERROR: metadata JSON file does not exist: $META_JSON"
	exit 1
fi

case "$DSKEY" in
	*\ *)
		echo "ERROR: dataset key can not contain spaces: $DSKEY"
		exit 1
		;;
esac

# Helper to extract a scalar attribute from the metadata JSON.
# Usage: get_meta <attribute>
function get_meta() {
	jq -r --arg a "$1" '.[$a] // ""' $META_JSON
}

# Helper to extract an attribute that may be a string or an array of strings.
# Arrays are converted to a single string with items separated by newlines.
# Usage: get_meta_str <attribute>
function get_meta_str() {
	jq -r --arg a "$1" 'if (.[$a] | type) == "array" then (.[$a] | join("\n")) else (.[$a] // "") end' $META_JSON
}

# Helper to extract an array attribute. Strings are wrapped in a single-item
# array; missing attributes yield an empty array.
# Usage: get_meta_arr <attribute>
function get_meta_arr() {
	jq -r --arg a "$1" 'if (.[$a] | type) == "array" then .[$a] elif (.[$a] | type) == "string" then [.[$a]] else [] end' $META_JSON
}

# The dataset key comes from the metadata itself (e.g. 'gaia-dr4-best'),
# not from the single-word lookup name (e.g. 'best').
DSKEY=$(get_meta key)
if [ -z "$DSKEY" ]; then
  echo "ERROR: metadata has no 'key' attribute!"
  exit 1
fi

NAME=$(get_meta name)
TYPE=$(get_meta type)
DESCRIPTION=$(get_meta description)
EPOCH=$(get_meta epoch)
VERSION=$(get_meta version)
MINGSSVERSION=$(get_meta mingsversion)
CREATOR=$(get_meta creator)
NOTES=$(get_meta_str releasenotes)
REPLACES=$(get_meta replaces)
CREATOR=$(get_meta creator)
# links: array of strings. Accepts a single string (legacy 'link') too.
LINKS_JSON=$(jq -c 'if (.links | type) == "array" then .links elif (.links | type) == "string" then [.links] elif (.link | type) == "string" then [.link] else [] end' $META_JSON)
# Single link: first element of 'links' if present, else legacy 'link'.
LINK=$(jq -r 'if (.links | type) == "array" and (.links | length) > 0 then .links[0] elif (.links | type) == "string" then .links elif (.link | type) == "string" then .link else "" end' $META_JSON)

if [ -z "$NAME" ] || [ -z "$DESCRIPTION" ]; then
  echo "ERROR: could not retrieve metadata (name and description are required)!"
  exit 1
fi

CATALOG_BASE=$LOCATION/catalog-$DSKEY
CATALOG_FOLDER=$CATALOG_BASE/catalog
CATALOG_FILE=$CATALOG_BASE/dataset.json
CATALOG_DATA=$CATALOG_FOLDER/$DSKEY

echo "CATALOG_FOLDER: $CATALOG_FOLDER"
echo "CATALOG_FILE:   $CATALOG_FILE"
echo "CATALOG_DATA:   $CATALOG_DATA"

# PARSE DATA AND CHECK VALUES

# Get size in bytes of dataset
SIZE_BYTES=$(set -- $(du -b --max-depth=1 $LOCATION) && AUXVAR=$(( $# - 1 )) && echo ${!AUXVAR})
# Get particles
NOBJECTS=$(set -- $(grep Particles: $LOCATION/log) && echo ${!#})


# Check values
if [ -z "$VERSION" ]; then
    echo "ERROR: Version is empty"
    exit 1
fi
if [ -z "$SIZE_BYTES" ]; then
    echo "ERROR: Size (bytes) is empty"
    exit 1
fi
if [ -z "$NOBJECTS" ]; then
    echo "ERROR: Nobjects is empty"
    exit 1
fi

echo "SIZE:           $SIZE_BYTES bytes"
echo "NOBJECTS:       $NOBJECTS"
echo "EPOCH:          $EPOCH"
echo "VERSION:        $VERSION"
echo "LINK:           $LINK"
echo "LINKS:          $LINKS_JSON"
echo "REPLACES:       $REPLACES"
echo "CREATOR:        $CREATOR"
echo "CREDITS:        $(printf '%s' "$CREDITS_JSON" | jq -c . 2>/dev/null)"

# CREATE AND MOVE CATALOG
mkdir -p $CATALOG_DATA
mv $LOCATION/log $LOCATION/metadata.bin $LOCATION/particles $CATALOG_DATA

# PREPARE JSON DESCRIPTOR FILE
cp $SCRIPT_DIR/catalog-template.json $CATALOG_FILE

# Substitute a placeholder with the given value, JSON-encoding it if it is
# not already valid JSON (numbers, arrays, objects are inserted verbatim).
# Usage: subst <placeholder> <value>
function subst() {
  local PH=$1
  local VAL=$2
  # JSON-encode the value so that strings are escaped correctly.
  # Empty values are substituted with an empty JSON string and removed later.
  local ENCODED
  if [ -z "$VAL" ]; then
    ENCODED='""'
  else
    ENCODED=$(printf '%s' "$VAL" | jq -R .)
  fi
  sed -i "s|\"<$PH>\"|$ENCODED|g" $CATALOG_FILE
}

# Bare KEY substitution first (used in unquoted file paths in the template),
# then the quoted one. Uses the dataset key from the metadata.
sed -i "s|<KEY>|$DSKEY|g" $CATALOG_FILE
subst NAME "$NAME"
subst KEY "$DSKEY"
subst TYPE "$TYPE"
subst DESCRIPTION "$DESCRIPTION"
subst NOTES "$NOTES"
subst LINK "$LINK"
subst REPLACES "$REPLACES"
subst CREATOR "$CREATOR"

# Numeric fields: substitute without quotes.
function subst_num() {
  local PH=$1
  local VAL=$2
  sed -i "s/<$PH>/$VAL/g" $CATALOG_FILE
}
subst_num VERSION "$VERSION"
subst_num EPOCH "$EPOCH"
subst_num SIZE_BYTES "$SIZE_BYTES"
subst_num NOBJECTS "$NOBJECTS"

# Array-valued attributes: insert verbatim as JSON arrays (compact).
if [ -n "$LINKS_JSON" ] && [ "$LINKS_JSON" != "[]" ]; then
  sed -i "s|\[\"<LINKS>\"\]|$LINKS_JSON|g" $CATALOG_FILE
fi
CREDITS_JSON=$(get_meta_arr credits | jq -c . 2>/dev/null)
if [ -n "$CREDITS_JSON" ] && [ "$CREDITS_JSON" != "[]" ]; then
  sed -i "s|\[\"<CREDITS>\"\]|$CREDITS_JSON|g" $CATALOG_FILE
fi

# Remove unsubstituted placeholders (attributes not present in the metadata).
sed -i -e '/"<LINKS>"/d' -e '/"<CREDITS>"/d' $CATALOG_FILE

# mingsversion: use metadata value if present, otherwise keep the template default.
MINGSS=$(get_meta mingsversion)
if [ -n "$MINGSS" ]; then
  sed -i 's/"mingsversion": 3060100/"mingsversion": '"$MINGSS"'/' $CATALOG_FILE
fi

subst_num SIZE_BYTES "$SIZE_BYTES"
subst_num NOBJECTS "$NOBJECTS"

# Remove empty optional attributes so that they do not appear as empty
# strings or empty arrays in the final descriptor.
jq 'if .replaces == "" then del(.replaces) else . end
  | if .creator == "" then del(.creator) else . end
  | if .link == "" then del(.link) else . end
  | if (.links | type) == "array" and (.links | length) == 0 then del(.links) else . end
  | if (.credits | type) == "array" and (.credits | length) == 0 then del(.credits) else . end
  | if .releasenotes == "" then del(.releasenotes) else . end' $CATALOG_FILE > $CATALOG_FILE.tmp && mv $CATALOG_FILE.tmp $CATALOG_FILE

# Validate the generated descriptor.
jq -e . $CATALOG_FILE > /dev/null 2>&1
if [ $? -ne 0 ]; then
  echo "ERROR: generated dataset.json is not valid JSON: $CATALOG_FILE"
  exit 1
fi

# TAR
TAR_FILE=catalog-$DSKEY.tar.gz
cd $LOCATION
tar -czvf $TAR_FILE catalog-$DSKEY

set -- $(md5sum "$TAR_FILE") && echo $1 > md5
set -- $(sha256sum "$TAR_FILE") && echo $1 > sha256
cd -

echo "Done: $LOCATION/$TAR_FILE"
